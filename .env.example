# GEMINI_API_KEY: Required for server-side Gemini AI message translation and voice transcription.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TENOR_API_KEY or GIPHY_API_KEY: Required for real animated GIF search and trending GIFs.
# Obtain a free key from https://developers.giphy.com/ or https://developers.google.com/tenor
GIPHY_API_KEY=""
TENOR_API_KEY=""

# Optional WebRTC TURN Server configuration for symmetric NAT / strict firewall calling.
# Standard STUN servers are enabled by default.
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
